{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "serve": "node --env-file=.env.local server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node ./tests/renameChecks.test.js",
    "test:unit": "vitest run --dir .testing/UnitTesting",
    "test:unit:watch": "vitest --dir .testing/UnitTesting",
    "test:integration": "vitest run --dir .testing/IntegrationTesting",
    "test:integration:watch": "vitest --dir .testing/IntegrationTesting",
    "test:all": "vitest run --dir .testing",
    "test:manual:new": "node tests/init_manual_run.js",
    "prompts:push": "node update_prompts.js",
    "prompts:pull": "node pull_prompts.js",
    "deploy:cloud": "gcloud builds submit --tag europe-west3-docker.pkg.dev/scape-data-capture/scape-evaluator/scape-evaluator && gcloud run deploy scape-evaluator --image europe-west3-docker.pkg.dev/scape-data-capture/scape-evaluator/scape-evaluator:latest --platform managed --region europe-west3 --allow-unauthenticated --set-secrets GEMINI_API_KEY=GEMINI_API_KEY:latest",
    "deploy:hosting": "npm run build && npx -y firebase-tools deploy --only hosting:scape-pick-pilot"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "qrcode": "^1.5.4",
    "user-event": "^3.0.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "browser-image-compression": "^2.0.2",
    "firebase": "^12.13.0",
    "happy-dom": "^20.11.6",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-firebase-hooks": "^5.1.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
